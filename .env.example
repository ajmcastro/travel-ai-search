# Copy this file to .env and adjust for your local setup.
# Never commit .env — it is gitignored.

# OpenSearch connection
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development

# Embeddings (Milestone 5)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranking (Milestone 8)
RERANKING_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_K=50

# Query understanding (Milestone 9)
QUERY_UNDERSTANDING_ENABLED=true

# Query rewriting (Milestone 10)
# Set QUERY_REWRITING_ENABLED=true to activate the rewriter at startup.
# LLM_PROVIDER selects the backend: "local" (keyword expansion, no API key),
# "echo" (identity stub, for testing), "bedrock" (Milestone 12, requires AWS).
QUERY_REWRITING_ENABLED=false
LLM_PROVIDER=local

# Query expansion / multi-query retrieval (Milestone 11)
# Set QUERY_EXPANSION_ENABLED=true to create a QueryExpander at startup.
# NUM_EXPANSION_QUERIES controls how many query variants are generated per request.
QUERY_EXPANSION_ENABLED=false
NUM_EXPANSION_QUERIES=3
