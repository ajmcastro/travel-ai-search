# Copy this file to .env and adjust for your local setup.
# Never commit .env — it is gitignored.

# OpenSearch connection
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Application
LOG_LEVEL=INFO
# LOG_FORMAT=text    # Set to "json" for NDJSON structured logging (production deployments).
ENVIRONMENT=development

# Embeddings (Milestone 5)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranking (Milestone 8)
RERANKING_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_K=50

# Query understanding (Milestone 9)
QUERY_UNDERSTANDING_ENABLED=true

# Query rewriting (Milestone 10)
# Set QUERY_REWRITING_ENABLED=true to activate the rewriter at startup.
# LLM_PROVIDER selects the backend: "local" (keyword expansion, no API key),
# "echo" (identity stub, for testing), "bedrock" (Milestone 12, requires AWS).
QUERY_REWRITING_ENABLED=false
LLM_PROVIDER=local

# Query expansion / multi-query retrieval (Milestone 11)
# Set QUERY_EXPANSION_ENABLED=true to create a QueryExpander at startup.
# NUM_EXPANSION_QUERIES controls how many query variants are generated per request.
QUERY_EXPANSION_ENABLED=false
NUM_EXPANSION_QUERIES=3

# AWS Bedrock (Milestone 12) — optional; full system runs locally without these.
# NEVER commit real credentials — use environment variables or IAM roles.
#
# AWS_DEFAULT_REGION and standard AWS credential env vars are read by boto3 directly:
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_SESSION_TOKEN=...   (only for temporary credentials)
#
# Provider selection (default: local for all)
#   EMBEDDING_PROVIDER=local          # "local" or "bedrock"
#   RERANKER_PROVIDER=local           # "local" or "bedrock"
#   LLM_PROVIDER=local                # "local", "echo", or "bedrock"
#
# Bedrock model IDs (change region/model to match your account access)
#   AWS_REGION=us-east-1
#   BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
#   BEDROCK_EMBEDDING_DIMENSION=1024
#   BEDROCK_LLM_MODEL_ID=anthropic.claude-haiku-4-5-20251001
#   BEDROCK_RERANKER_MODEL_ID=cohere.rerank-v3-5:0
#
# Note: switching EMBEDDING_PROVIDER=bedrock changes the vector dimension (384→1024).
# Update EMBEDDING_DIMENSION=1024 and recreate the index: make create-index && make generate-embeddings

# ── RAG / Destination knowledge base (Milestone 13) ───────────────────────────
#
# RAG_ENABLED=false         # Set to true to enable knowledge retrieval + synthesis.
#                           # Requires running: make generate-knowledge && make ingest-knowledge
# KNOWLEDGE_INDEX_NAME=travel_destinations
# RAG_CONTEXT_K=3           # Number of destination knowledge docs to retrieve per query.
#
# Synthesis uses the LLM configured by LLM_PROVIDER (see Bedrock settings above).
# For local testing without an LLM: LLM_PROVIDER=echo (returns the prompt as-is).

# ── Graph-enhanced retrieval (Milestone 14) ────────────────────────────────────
#
# GRAPH_ENABLED=true        # Set to false to disable the in-memory destination graph.
#                           # When disabled, all /graph/* endpoints return HTTP 503.
# KNOWLEDGE_FILE_PATH=data/knowledge/destinations.jsonl
#                           # Path to the JSONL knowledge file used to seed the graph.
#                           # Relative paths are resolved from the server working directory.
#                           # No extra setup needed — the graph is built at startup.

# ── LLM-as-judge evaluation (Milestone 16) ────────────────────────────────────
#
# JUDGE_PROVIDER=echo       # "echo" (fixed score=2, no LLM call) or "bedrock".
#                           # "echo" is safe for CI and dry runs — no AWS required.
#                           # "bedrock" requires AWS credentials and the model below.
#
# BEDROCK_JUDGE_MODEL_ID=amazon.nova-lite-v1:0
#                           # Judge model must be a DIFFERENT family from the generator.
#                           # The generator uses Anthropic Claude (via BedrockLLMProvider).
#                           # Default: Amazon Nova Lite — fast, low-cost, widely available
#                           # in us-east-1.  Never use an Anthropic model here (common-mode
#                           # bias would inflate agreement scores).
JUDGE_PROVIDER=echo
BEDROCK_JUDGE_MODEL_ID=amazon.nova-lite-v1:0

# ── Learned sparse retrieval / SPLADE (Milestone 17) ─────────────────────────
#
# SPLADE_ENABLED=false     # Set to true to load the sparse encoder at startup.
#                          # Requires make generate-sparse-embeddings to be run first.
#                          # When false, GET /search/sparse returns HTTP 503.
# This required a HuggingFace authentication token to download the model.  See README for instructions.
# SPLADE_MODEL_NAME=naver/splade-cocondenser-ensemble-distil
#                          # Any HuggingFace masked-language model.
#                          # Default: NAVER Labs SPLADE distilled ensemble model.
#                          # Downloads ~300 MB on first use; cached in ~/.cache/huggingface/
# This model does not require a HuggingFace authentication token to download.
# SPLADE_MODEL_NAME=prithivida/Splade_PP_en_v1 # does not require hugging face authentication
#
# SPLADE_TOP_K_TERMS=64    # Max vocabulary terms per query vector sent to OpenSearch.
#                          # Higher = better rare-term recall, slower query execution.
SPLADE_ENABLED=false
SPLADE_MODEL_NAME=naver/splade-cocondenser-ensemble-distil
SPLADE_TOP_K_TERMS=64

# ── ColBERT late-interaction reranking (Milestone 18) ─────────────────────────
#
# ColBERT encodes each document into ALL token embeddings (not a single vector).
# Relevance is scored via MaxSim: Σᵢ max_j (qᵢ · dⱼ) — sum over query tokens of
# the maximum similarity against all document token embeddings.
#
# COLBERT_MODEL_NAME: HuggingFace checkpoint.  Default is colbert-ir/colbertv2.0
#   (~400 MB, 128-dim projection; downloads once and caches in ~/.cache/huggingface/).
#   Quick alternative (already cached if M5 was run):
#     COLBERT_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2   (384-dim, no projection)
# COLBERT_EMBEDDINGS_DIR: where generate_colbert_embeddings.py saves .npy files.
# COLBERT_DOC_MAXLEN: max tokens per document (must match what was used during generation).
# COLBERT_QUERY_MAXLEN: max tokens per query (32 is the ColBERT v2 default).
#
# To activate ColBERT reranking in the API:
#   RERANKING_ENABLED=true
#   RERANKER_PROVIDER=colbert
#   Then run: make generate-embeddings && make generate-colbert-embeddings
COLBERT_MODEL_NAME=colbert-ir/colbertv2.0
COLBERT_EMBEDDINGS_DIR=data/processed/colbert_embeddings
COLBERT_DOC_MAXLEN=128
COLBERT_QUERY_MAXLEN=32

# ── Two-tower fine-tuning (Milestone 19) ──────────────────────────────────────
#
# FINE_TUNED_EMBEDDING_MODEL_PATH: local path to a fine-tuned SentenceTransformer.
#   When set, `make evaluate-fine-tuned` loads this model for the fine-tuned-vector
#   strategy.  Leave empty (the default) to use the base model.
#
# Full pipeline:
#   make prepare-fine-tuning-data      # mine BM25 hard negatives, write pairs JSONL
#   make fine-tune-embeddings          # contrastive training, saves model below
#   # then set the path and evaluate:
#   make evaluate-fine-tuned
#
# FINE_TUNED_EMBEDDING_MODEL_PATH=data/models/bi-encoder-travel
