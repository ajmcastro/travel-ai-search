# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
*.egg-info/
dist/
build/

# UV
.python-version

# Secrets — never commit real credentials
.env

# Editors
.idea/
.vscode/
*.swp
*.swo

# macOS
.DS_Store

# Generated data — ignore file contents but commit the directory markers (.gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/evaluation/results/*
!data/evaluation/results/.gitkeep

# Notebooks
notebooks/.ipynb_checkpoints/

# Testing / coverage
.coverage
htmlcov/
.pytest_cache/

# mypy
.mypy_cache/

# ruff
.ruff_cache/
